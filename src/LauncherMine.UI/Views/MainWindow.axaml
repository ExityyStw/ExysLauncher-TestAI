<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LauncherMine.UI.ViewModels"
        xmlns:models="using:LauncherMine.Core.Models"
        x:Class="LauncherMine.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Exys Launcher"
        Width="800" Height="550"
        MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14, 8" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderFooterBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20, 12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="EX" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentOnBrush}" />
                    </Border>
                    <TextBlock Text="Exys Launcher" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Contas -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8, 4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding SelectedAccount}"
                                      MinWidth="100" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding Username}" />
                                            <TextBlock Text="MS" Foreground="{DynamicResource AccentBrush}" FontSize="10" 
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AccountType.Microsoft}}" />
                                            <TextBlock Text="OFF" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" 
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AccountType.Offline}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="×" Width="20" Height="20" FontSize="12" Background="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource DangerFgBrush}" Padding="0" 
                                    Click="OnRemoveAccountClicked" ToolTip.Tip="Remover" />
                        </StackPanel>
                    </Border>
                    <Button Name="AddAccountButton" Content="+" Width="28" Height="24" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" 
                            FontSize="14" Padding="0" Click="OnAddAccountMenuClicked" ToolTip.Tip="Adicionar">
                        <Button.ContextMenu>
                            <ContextMenu Name="AccountContextMenu">
                                <MenuItem Header="Conta Offline" Click="OnAddAccountClicked" />
                                <MenuItem Header="Login Microsoft" Click="OnLoginMicrosoftClicked" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Name="ThemeToggleButton" Content="🌙" Width="28" Height="24" Background="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                            FontSize="12" Padding="0" Click="OnThemeToggleClicked" ToolTip.Tip="Alternar tema" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT - DASHBOARD -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Center">
                
                <!-- Instância Atual -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Instância Atual" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue='Nenhuma selecionada'}" 
                                           FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedInstance.GameVersion, FallbackValue='-'} • {Binding SelectedInstance.LoaderType, FallbackValue='-'}" 
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Trocar Instância" Click="OnShowInstancesClicked" 
                                    Background="{DynamicResource HeaderFooterBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Memória RAM" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding RamAllocationMb, StringFormat='{}{0} MB'}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                        <Slider Minimum="{Binding MinRamSliderMb}" Maximum="{Binding MaxRamSliderMb}" Value="{Binding RamAllocationMb}" 
                                IsSnapToTickEnabled="True" TickFrequency="512" />
                        <TextBlock Text="{Binding RamInfoText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Botão JOGAR Grande -->
                <Button Command="{Binding PlayCommand}" IsEnabled="{Binding !IsBusy}"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" 
                        Height="60" FontSize="18" FontWeight="Bold">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="▶" VerticalAlignment="Center" />
                        <TextBlock Text="JOGAR" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Ações Rápidas -->
                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0" Content="Gerenciar Instâncias" Click="OnShowInstancesClicked"
                            Background="{DynamicResource HeaderFooterBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="Configurações" Click="OnShowSettingsClicked"
                            Background="{DynamicResource HeaderFooterBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="8,0,0,0" />
                </Grid>

                <!-- Status -->
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                <ProgressBar Height="4" Maximum="100" Value="{Binding ProgressValue}" 
                             IsVisible="{Binding IsProgressVisible}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderSubtleBrush}" CornerRadius="2" HorizontalAlignment="Center" Width="400" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
