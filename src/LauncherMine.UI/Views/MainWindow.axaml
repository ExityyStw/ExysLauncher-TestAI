<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LauncherMine.UI.ViewModels"
        xmlns:models="using:LauncherMine.Core.Models"
        x:Class="LauncherMine.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Exys Launcher - TestAI"
        Width="1040" Height="700"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, sans-serif" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Botões Gerais -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <!-- Abas Segmentadas do Topo -->
        <Style Selector="RadioButton.navtab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="11, 7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.navtab:checked">
            <Setter Property="Background" Value="{DynamicResource NavActiveBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavActiveFgBrush}" />
        </Style>
        <Style Selector="RadioButton.navtab:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="70, *, 80">

        <!-- ================= 1. CABEÇALHO MODERNO ================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderFooterBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="18, 0">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Logo & Nome -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                        <TextBlock Text="⛏" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Exys Launcher" FontSize="17" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6, 2" VerticalAlignment="Center">
                                <TextBlock Text="TestAI" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentOnBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Gerenciador Multiplataforma" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- 4 Abas de Navegação -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8, 0">
                    <RadioButton Classes="navtab" Content="🎮  Jogar"
                                 IsChecked="{Binding IsPlayTab, Mode=OneWay}"
                                 Click="OnTabJogarClicked" />
                    <RadioButton Classes="navtab" Content="📚  Instâncias"
                                 IsChecked="{Binding IsInstancesTab, Mode=OneWay}"
                                 Click="OnTabInstanciasClicked" />
                    <RadioButton Classes="navtab" Content="⚡  Loader &amp; JVM"
                                 IsChecked="{Binding IsJvmTab, Mode=OneWay}"
                                 Click="OnTabJvmClicked" />
                    <RadioButton Classes="navtab" Content="📦  Importar ZIP"
                                 IsChecked="{Binding IsImportTab, Mode=OneWay}"
                                 Click="OnTabImportClicked" />
                </StackPanel>

                <!-- Perfil do Jogador & Alternância de Tema -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="8, 3">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentInfoBrush}">
                                <TextBlock Text="👤" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                            <ComboBox ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding SelectedAccount}"
                                      MinWidth="120" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AccountProfile">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="[MS]" Foreground="{DynamicResource AccentInfoBrush}" FontSize="11"
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AccountType.Microsoft}}" />
                                            <TextBlock Text="[Offline]" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                                       IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static models:AccountType.Offline}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button Content="+" ToolTip.Tip="Nova Conta" Click="OnAddAccountClicked"
                            Width="36" Height="36" Background="{DynamicResource SecondaryBtnBgBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="18" />

                    <Button Content="{Binding ThemeToggleIcon}"
                            ToolTip.Tip="{Binding ThemeToggleTooltip}"
                            Command="{Binding ToggleThemeCommand}"
                            Width="36" Height="36"
                            Background="{DynamicResource SecondaryBtnBgBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="15" />
                </StackPanel>

            </Grid>
        </Border>

        <!-- ================= 2. ÁREA CENTRAL COM SCROLL COMPLETO E FLUIDO ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30, 24, 30, 40">
            <Grid MaxWidth="880" HorizontalAlignment="Stretch">

                <!-- ========== ABA 0: JOGAR (PAINEL PRINCIPAL) ========== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsPlayTab}">

                    <!-- Cartão Heroico da Instância Atual -->
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="26">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue='NeoForge 1.21.1 Pack'}"
                                               FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Instância isolada (Prism-like): mods, saves e configs independentes." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BadgeSuccessBgBrush}" BorderBrush="{DynamicResource BadgeSuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8, 3">
                                        <TextBlock Text="ISOLADA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeSuccessFgBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BadgeInfoBgBrush}" BorderBrush="{DynamicResource BadgeInfoBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8, 3">
                                        <TextBlock Text="ANTI-TAMPERING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BadgeInfoFgBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0, 2" />

                            <!-- 3 Chips Técnicos -->
                            <Grid ColumnDefinitions="*, *, *">
                                <Border Grid.Column="0" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12, 10" Margin="0,0,6,0">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="VERSÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGameVersion}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12, 10" Margin="6,0,6,0">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="MOD LOADER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedLoader}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12, 10" Margin="6,0,0,0">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock Text="RUNTIME JAVA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Java 21 (Temurin 64-Bit)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentInfoBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cartão de Memória RAM com Detecção e Validação de 16 GB -->
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="22">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Alocação de Memória RAM" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding RamInfoText}" FontSize="12" Foreground="{DynamicResource AccentInfoBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource BadgeSuccessBgBrush}" BorderBrush="{DynamicResource BadgeSuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10, 4" Margin="12, 0" VerticalAlignment="Center"
                                        IsVisible="{Binding HasRecommended16GbRam}">
                                    <TextBlock Text="{Binding RamBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeSuccessFgBrush}" />
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource BadgeWarnBgBrush}" BorderBrush="{DynamicResource BadgeWarnBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10, 4" Margin="12, 0" VerticalAlignment="Center"
                                        IsVisible="{Binding !HasRecommended16GbRam}">
                                    <TextBlock Text="{Binding RamBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BadgeWarnFgBrush}" />
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14, 6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RamAllocationMb, StringFormat='{}{0} MB'}" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" FontSize="15" />
                                </Border>
                            </Grid>

                            <!-- Slider Limitado com Base na RAM Física Real do Usuário -->
                            <Slider Minimum="{Binding MinRamSliderMb}" Maximum="{Binding MaxRamSliderMb}" Value="{Binding RamAllocationMb}"
                                    LargeChange="1024" SmallChange="512" IsSnapToTickEnabled="True" TickFrequency="1024" Margin="0, 4" />

                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <TextBlock Grid.Column="0" Text="1 GB (Mínimo)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="6 GB - 8 GB (Ideal para 300+ Mods)" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="{Binding MaxRamSliderMb, StringFormat='{}{0} MB (Máximo Seguro)'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cartão de Garbage Collector -->
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Otimização de Garbage Collector (GC)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Configurações automáticas para eliminar micro-travamentos e quedas de FPS." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding JvmPresetNames}"
                                      SelectedItem="{Binding SelectedJvmPreset}"
                                      Width="340" Height="40" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="8" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========== ABA 1: GERENCIAR INSTÂNCIAS (PRISM-LIKE COMPLETO) ========== -->
                <StackPanel Spacing="16" IsVisible="{Binding IsInstancesTab}">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Gerenciador de Instâncias Isoladas" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Cada instância possui mods, saves e configurações independentes." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ Nova Instância" Click="OnCreateInstanceClicked"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" FontWeight="Bold" Padding="16, 8" />
                    </Grid>

                    <!-- Lista de Instâncias Criadas -->
                    <ItemsControl ItemsSource="{Binding Instances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:InstanceMetadata">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0, 0, 0, 10">
                                    <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border Background="{DynamicResource BadgeInfoBgBrush}" CornerRadius="4" Padding="6, 2">
                                                    <TextBlock Text="{Binding GameVersion}" FontSize="11" Foreground="{DynamicResource BadgeInfoFgBrush}" FontWeight="Bold" />
                                                </Border>
                                                <Border Background="{DynamicResource BadgeSuccessBgBrush}" CornerRadius="4" Padding="6, 2">
                                                    <TextBlock Text="{Binding LoaderType}" FontSize="11" Foreground="{DynamicResource BadgeSuccessFgBrush}" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>

                                        <!-- Botão Abrir Pasta da Instância -->
                                        <Button Grid.Column="1" Content="📁 Abrir Pasta"
                                                Click="OnOpenInstanceFolderClicked"
                                                Background="{DynamicResource SecondaryBtnBgBrush}" Foreground="{DynamicResource SecondaryBtnFgBrush}" Padding="12, 6" Margin="0, 0, 8, 0" />

                                        <!-- Botão Selecionar para Jogar -->
                                        <Button Grid.Column="2" Content="Selecionar"
                                                Click="OnSelectInstanceClicked"
                                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" FontWeight="Bold" Padding="14, 6" Margin="0, 0, 8, 0" />

                                        <!-- Botão Excluir -->
                                        <Button Grid.Column="3" Content="🗑"
                                                Click="OnDeleteInstanceClicked"
                                                Background="{DynamicResource DangerBgBrush}" Foreground="{DynamicResource DangerFgBrush}" Padding="10, 6" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ========== ABA 2: OPÇÕES DE MOD LOADER & JVM ========== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsJvmTab}">
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="26">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Configurações de Execução, Versões e Mod Loaders" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <Grid ColumnDefinitions="*, *, *" Margin="0, 4">
                                <StackPanel Grid.Column="0" Margin="0, 0, 10, 0" Spacing="6">
                                    <TextBlock Text="Versão do Minecraft:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                    <ComboBox ItemsSource="{Binding AvailableGameVersions}" SelectedItem="{Binding SelectedGameVersion}"
                                              HorizontalAlignment="Stretch" Height="40" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5, 0, 5, 0" Spacing="6">
                                    <TextBlock Text="Mod Loader Escolhido:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                    <ComboBox ItemsSource="{Binding AvailableLoaders}" SelectedItem="{Binding SelectedLoader}"
                                              HorizontalAlignment="Stretch" Height="40" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="8" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10, 0, 0, 0" Spacing="6">
                                    <TextBlock Text="Versão do Loader:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                    <ComboBox ItemsSource="{Binding AvailableLoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}"
                                              HorizontalAlignment="Stretch" Height="40" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="8" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Argumentos Personalizados da JVM (Flags de Performance):" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <TextBox Text="{Binding CustomJvmArgsText}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                     Background="{DynamicResource CodeBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource CodeFgBrush}"
                                     FontFamily="Cascadia Code, Consolas" FontSize="12" CornerRadius="6" />

                            <CheckBox IsChecked="{Binding CloseLauncherOnLaunch}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <StackPanel Orientation="Vertical" Spacing="2">
                                    <TextBlock Text="Fechar launcher ao abrir o jogo (Economia de 100% de RAM)" FontWeight="Bold" />
                                    <TextBlock Text="Encerra o processo do launcher após o Java iniciar para deixar toda a memória do PC livre para os mods." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding OpenConsoleOnLaunch}" Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock Text="Exibir console de logs em tempo real para depuração de erros" FontWeight="Bold" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== ABA 3: IMPORTAR MODPACK ZIP ========== -->
                <StackPanel Spacing="18" IsVisible="{Binding IsImportTab}">
                    <Border Background="{DynamicResource CardBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="32">
                        <StackPanel Spacing="18" HorizontalAlignment="Center" MaxWidth="620">

                            <Border Width="64" Height="64" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource AccentInfoBrush}" BorderThickness="2" CornerRadius="32" HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Importar Modpack (.ZIP)" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Selecione o arquivo .zip exportado do CurseForge ou Modrinth. Todos os mods, arquivos de configuração e scripts serão extraídos com isolamento e integridade verificada."
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 8">
                                <TextBox Grid.Column="0" Text="{Binding ImportZipPath}" Watermark="Caminho do arquivo de modpack (.zip)..."
                                         Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Height="42" CornerRadius="6, 0, 0, 6" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Procurar .ZIP..." Click="OnBrowseZipClicked"
                                        Background="{DynamicResource SecondaryBtnBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Foreground="{DynamicResource AccentInfoBrush}" Height="42" CornerRadius="0, 6, 6, 0" Padding="18, 0" />
                            </Grid>

                            <Button Content="Instalar e Criar Instância" Click="OnConfirmImportClicked"
                                    HorizontalAlignment="Center" Width="260" Height="46"
                                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" FontWeight="Bold" FontSize="14" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ================= 3. RODAPÉ FIXO COM BARRA DE STATUS E BOTÃO JOGAR ================= -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderFooterBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="28, 14">
            <Grid ColumnDefinitions="*, Auto">

                <!-- Status & Barra de Progresso -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8" Margin="0, 0, 24, 0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <ProgressBar Height="6" Maximum="100" Value="{Binding ProgressValue}"
                                 IsVisible="{Binding IsProgressVisible}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressBgBrush}" CornerRadius="3" />
                </StackPanel>

                <!-- Botão JOGAR -->
                <Button Grid.Column="1"
                        Command="{Binding PlayCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Width="220" Height="50"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="10"
                        FontWeight="Black" FontSize="16"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontSize="16" Foreground="{DynamicResource AccentOnBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="JOGAR" Foreground="{DynamicResource AccentOnBrush}" FontWeight="Black" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>
</Window>
