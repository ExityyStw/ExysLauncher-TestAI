<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LauncherMine.UI.Views.AddAccountDialog"
        Title="Adicionar Conta de Jogador"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F111A">

    <Border Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="18" Foreground="#10B981" VerticalAlignment="Center" />
                <TextBlock Text="Adicionar Jogador Offline" FontSize="16" FontWeight="Black" Foreground="#F8FAFC" VerticalAlignment="Center" />
            </StackPanel>
            
            <TextBlock Text="Digite o nome de usuário (3 a 16 caracteres alfanuméricos):" 
                       FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" />

            <TextBox Name="UsernameBox" Watermark="Ex: Steve_BR" 
                     Background="#161824" BorderBrush="#252A3D" Foreground="#F8FAFC" 
                     Height="40" CornerRadius="6" FontWeight="Bold" VerticalContentAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 8, 0, 0">
                <Button Content="Cancelar" Click="OnCancelClicked" Background="#1E2333" BorderBrush="#252A3D" Foreground="#E2E8F0" Padding="14, 6" />
                <Button Content="Salvar Conta" Click="OnSaveClicked" Background="#10B981" Foreground="#0B0D14" FontWeight="Bold" Padding="16, 6" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
