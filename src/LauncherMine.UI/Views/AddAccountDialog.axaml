<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LauncherMine.UI.Views.AddAccountDialog"
        Title="Adicionar Conta de Jogador"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBgBrush}">

    <Border Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="👤" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Adicionar Jogador Offline" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            
            <TextBlock Text="Digite o nome de usuário (3 a 16 caracteres alfanuméricos):" 
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

            <TextBox Name="UsernameBox" Watermark="Ex: Steve_BR" 
                     Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                     Height="40" CornerRadius="6" FontWeight="Bold" VerticalContentAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 8, 0, 0">
                <Button Content="Cancelar" Click="OnCancelClicked" Background="{DynamicResource SecondaryBtnBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Foreground="{DynamicResource SecondaryBtnFgBrush}" Padding="14, 6" />
                <Button Content="Salvar Conta" Click="OnSaveClicked" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentOnBrush}" FontWeight="Bold" Padding="16, 6" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
