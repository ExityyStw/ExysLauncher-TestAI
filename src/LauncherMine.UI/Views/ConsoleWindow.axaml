<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LauncherMine.UI.Views.ConsoleWindow"
        Title="Console de Diagnóstico de Logs"
        Width="820" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">

    <Grid RowDefinitions="*, 40">
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <TextBox Name="LogTextBox"
                     IsReadOnly="True"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="12"
                     Foreground="{DynamicResource CodeFgBrush}"
                     Background="{DynamicResource CodeBgBrush}"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource HeaderFooterBgBrush}" Padding="16, 6">
            <TextBlock Text="✦ Monitorando saída padrão (stdout / stderr) do Java do Minecraft em tempo real..." 
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
